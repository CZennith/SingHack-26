# Public frontend configuration. Only VITE_* variables are bundled into the browser.
VITE_API_BASE_URL=""

# mock keeps the UI on the prototype fixture repository. Set live only when a
# permitted API is configured; never put credentials in VITE_* variables.
VITE_CONNECTOR_MODE="mock"

# Public, non-secret client settings only. Keep credentials server-side.
VITE_DATA_AS_OF="2026-08-26"

# Server-only/private-mode settings. These are not exposed to browser code.
# The safe preview default never opens local client data.
DEMO_MODE="true"
WEALTH_DB_PATH=""

# Server-only OpenAI interpreter settings. Never expose the API key through VITE_*.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-luna
OPENAI_REASONING_EFFORT=low
OPENAI_TIMEOUT_SECONDS=30
