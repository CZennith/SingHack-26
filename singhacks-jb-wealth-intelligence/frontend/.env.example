# Backend base URL. Leave empty locally: Vite proxies /api to port 8000.
# Set this to a deployed backend origin (for example https://api.example.com).
VITE_API_BASE_URL=""

# Client profiles are fetched from GET /clients.
VITE_CONNECTOR_MODE="live"

# Public, non-secret client settings only. Keep credentials server-side.
VITE_DATA_AS_OF="2026-08-26"
