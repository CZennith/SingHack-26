{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://singhacks.local/contracts/analysis-result-1.0.0.schema.json",
  "title": "Calculator Analysis Result",
  "description": "Versioned, evidence-backed result envelope for future client-analysis calculators.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "result_metadata",
    "facts",
    "findings",
    "evidence",
    "warnings",
    "assumptions",
    "requires_rm_review"
  ],
  "properties": {
    "result_metadata": {
      "$ref": "#/$defs/ResultMetadata"
    },
    "facts": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/Fact"
      }
    },
    "findings": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/Finding"
      }
    },
    "evidence": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/Evidence"
      }
    },
    "warnings": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/Warning"
      }
    },
    "assumptions": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/Assumption"
      }
    },
    "requires_rm_review": {
      "type": "boolean",
      "description": "Whether the result requires RM review."
    }
  },
  "$defs": {
    "ResultMetadata": {
      "type": "object",
      "description": "Metadata identifying the result and its input snapshot.",
      "additionalProperties": false,
      "properties": {
        "result_type": {
          "const": "calculator_result",
          "description": "Discriminator for this result envelope."
        },
        "schema_version": {
          "const": "1.0.0",
          "description": "Version of this result contract."
        },
        "calculator_name": {
          "type": "string",
          "description": "Stable calculator name.",
          "minLength": 1
        },
        "calculator_version": {
          "type": "string",
          "description": "Semantic version of the calculator implementation.",
          "pattern": "^\\d+\\.\\d+\\.\\d+$",
          "minLength": 5
        },
        "client_id": {
          "type": "string",
          "description": "Client identifier.",
          "minLength": 1
        },
        "as_of_date": {
          "type": "string",
          "description": "Required ISO valuation date.",
          "format": "date",
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
        },
        "comparison_date": {
          "type": [
            "string",
            "null"
          ],
          "description": "Optional comparison ISO date.",
          "format": "date",
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
        },
        "period_start": {
          "type": [
            "string",
            "null"
          ],
          "description": "Inclusive period start.",
          "format": "date",
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
        },
        "period_end": {
          "type": [
            "string",
            "null"
          ],
          "description": "Inclusive period end.",
          "format": "date",
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
        },
        "input_snapshot_schema_version": {
          "type": "string",
          "description": "Version of the input client snapshot contract.",
          "pattern": "^\\d+\\.\\d+\\.\\d+$",
          "minLength": 5
        },
        "input_snapshot_calculation_version": {
          "type": "string",
          "description": "Calculation version recorded by the input snapshot.",
          "pattern": "^\\d+\\.\\d+\\.\\d+$",
          "minLength": 5
        },
        "status": {
          "type": "string",
          "enum": [
            "complete",
            "partial",
            "blocked"
          ],
          "description": "Completion state."
        },
        "input_current_exposure_version": {
          "type": [
            "string",
            "null"
          ],
          "description": "Semantic version of the current exposure-base input.",
          "pattern": "^\\d+\\.\\d+\\.\\d+$"
        },
        "input_previous_exposure_version": {
          "type": [
            "string",
            "null"
          ],
          "description": "Semantic version of the previous exposure-base input.",
          "pattern": "^\\d+\\.\\d+\\.\\d+$"
        }
      },
      "required": [
        "result_type",
        "schema_version",
        "calculator_name",
        "calculator_version",
        "client_id",
        "as_of_date",
        "input_snapshot_schema_version",
        "input_snapshot_calculation_version",
        "status"
      ]
    },
    "Scope": {
      "type": "object",
      "description": "The dimensions to which a fact applies.",
      "additionalProperties": false,
      "properties": {
        "level": {
          "type": "string",
          "description": "Scope level, such as client or portfolio."
        },
        "client_id": {
          "type": [
            "string",
            "null"
          ],
          "description": "Client identifier."
        },
        "portfolio_id": {
          "type": [
            "string",
            "null"
          ],
          "description": "Portfolio identifier."
        },
        "instrument_id": {
          "type": [
            "string",
            "null"
          ],
          "description": "Instrument identifier."
        },
        "asset_class": {
          "type": [
            "string",
            "null"
          ],
          "description": "Asset class."
        },
        "sector": {
          "type": [
            "string",
            "null"
          ],
          "description": "Sector."
        },
        "region": {
          "type": [
            "string",
            "null"
          ],
          "description": "Region."
        },
        "currency": {
          "type": [
            "string",
            "null"
          ],
          "description": "Currency for the scoped value."
        },
        "dimension": {
          "type": [
            "string",
            "null"
          ],
          "description": "Optional aggregation dimension."
        },
        "key": {
          "description": "Optional JSON-compatible aggregation key."
        },
        "sub_asset_class": {
          "type": [
            "string",
            "null"
          ],
          "description": "Optional sub-asset-class dimension."
        }
      },
      "required": [
        "level"
      ]
    },
    "Fact": {
      "type": "object",
      "description": "A calculated or retrieved value without interpretation.",
      "additionalProperties": false,
      "properties": {
        "fact_id": {
          "type": "string",
          "description": "Unique fact identifier.",
          "minLength": 1
        },
        "metric": {
          "type": "string",
          "description": "Fact metric name.",
          "minLength": 1
        },
        "scope": {
          "$ref": "#/$defs/Scope"
        },
        "current_value": {
          "description": "JSON-compatible current fact value."
        },
        "previous_value": {
          "description": "Optional JSON-compatible previous value."
        },
        "change": {
          "description": "Optional JSON-compatible change value."
        },
        "unit": {
          "type": "string",
          "description": "Unit identifying the value type.",
          "minLength": 1
        },
        "currency": {
          "type": [
            "string",
            "null"
          ],
          "description": "Currency for monetary values."
        },
        "as_of_date": {
          "type": "string",
          "description": "ISO date of current value.",
          "format": "date",
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
        },
        "comparison_date": {
          "type": [
            "string",
            "null"
          ],
          "description": "Optional ISO date of previous value.",
          "format": "date",
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
        },
        "current_weight_pct": {
          "description": "Optional current weight percentage."
        },
        "previous_weight_pct": {
          "description": "Optional previous weight percentage."
        },
        "change_weight_pp": {
          "description": "Optional weight change in percentage points."
        },
        "percentage_change": {
          "description": "Optional percentage change; null when previous value is zero."
        },
        "status": {
          "type": [
            "string",
            "null"
          ],
          "enum": [
            "added",
            "exited",
            "changed",
            "unchanged",
            null
          ],
          "description": "Optional change status."
        },
        "evidence_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "description": "Evidence identifier."
          },
          "description": "Optional supporting evidence IDs."
        }
      },
      "required": [
        "fact_id",
        "metric",
        "scope",
        "current_value",
        "unit",
        "as_of_date"
      ]
    },
    "Finding": {
      "type": "object",
      "description": "An evidence-backed observation derived from facts; not a recommendation.",
      "additionalProperties": false,
      "properties": {
        "finding_id": {
          "type": "string",
          "description": "Unique finding identifier.",
          "minLength": 1
        },
        "finding_type": {
          "type": "string",
          "description": "Rule-triggered observation type.",
          "minLength": 1
        },
        "severity": {
          "type": "string",
          "enum": [
            "info",
            "low",
            "medium",
            "high"
          ],
          "description": "Observation severity."
        },
        "title": {
          "type": "string",
          "description": "Human-readable observation title.",
          "minLength": 1
        },
        "description": {
          "type": "string",
          "description": "Human-readable observation description.",
          "minLength": 1
        },
        "fact_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "description": "Fact identifier."
          },
          "description": "Supporting fact IDs."
        },
        "evidence_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "description": "Evidence identifier."
          },
          "minItems": 1,
          "description": "Supporting evidence IDs."
        },
        "requires_rm_review": {
          "type": "boolean",
          "description": "Whether RM review is required."
        }
      },
      "required": [
        "finding_id",
        "finding_type",
        "severity",
        "title",
        "description",
        "fact_ids",
        "evidence_ids",
        "requires_rm_review"
      ]
    },
    "Evidence": {
      "type": "object",
      "description": "Traceability to a database record or snapshot field.",
      "additionalProperties": false,
      "properties": {
        "evidence_id": {
          "type": "string",
          "description": "Unique evidence identifier.",
          "minLength": 1
        },
        "source_table": {
          "type": "string",
          "description": "Database table or snapshot section.",
          "minLength": 1
        },
        "source_keys": {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": true,
          "description": "Keys locating the source record."
        },
        "value": {
          "description": "JSON-compatible source value."
        },
        "field": {
          "type": [
            "string",
            "null"
          ],
          "description": "Optional source field."
        },
        "source_date": {
          "type": [
            "string",
            "null"
          ],
          "description": "Optional ISO source date.",
          "format": "date",
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
        },
        "description": {
          "type": [
            "string",
            "null"
          ],
          "description": "Optional evidence description."
        }
      },
      "required": [
        "evidence_id",
        "source_table",
        "source_keys",
        "value"
      ]
    },
    "Warning": {
      "type": "object",
      "description": "A limitation, missing-data condition, or uncertainty.",
      "additionalProperties": false,
      "properties": {
        "warning_id": {
          "type": "string",
          "description": "Unique warning identifier.",
          "minLength": 1
        },
        "warning_type": {
          "type": "string",
          "description": "Warning category.",
          "minLength": 1
        },
        "severity": {
          "type": "string",
          "enum": [
            "info",
            "low",
            "medium",
            "high"
          ],
          "description": "Warning severity."
        },
        "message": {
          "type": "string",
          "description": "Human-readable limitation or uncertainty.",
          "minLength": 1
        },
        "evidence_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "description": "Evidence identifier."
          },
          "description": "Optional supporting evidence IDs."
        },
        "source_reference": {
          "type": [
            "object",
            "null"
          ],
          "additionalProperties": true,
          "description": "Optional source reference."
        }
      },
      "required": [
        "warning_id",
        "warning_type",
        "severity",
        "message"
      ]
    },
    "Assumption": {
      "type": "object",
      "description": "Explanatory metadata about an assumption.",
      "additionalProperties": false,
      "properties": {
        "assumption_id": {
          "type": "string",
          "description": "Unique assumption identifier.",
          "minLength": 1
        },
        "description": {
          "type": "string",
          "description": "Explicit assumption.",
          "minLength": 1
        },
        "impact": {
          "type": "string",
          "description": "Impact of the assumption.",
          "minLength": 1
        },
        "accepted": {
          "type": "boolean",
          "description": "Whether the assumption was accepted."
        }
      },
      "required": [
        "assumption_id",
        "description",
        "impact",
        "accepted"
      ]
    }
  }
}
